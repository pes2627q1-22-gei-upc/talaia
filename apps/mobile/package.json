{
  "name": "@talaia/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible-next": "^0.4.1",
    "@expo-google-fonts/big-shoulders-display": "^0.2.3",
    "@expo/ui": "~58.0.23",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "^2.118.0",
    "@talaia/shared": "*",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~58.0.19",
    "expo-apple-authentication": "~58.0.2",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "i18next": "^26.4.2",
    "maplibre-gl": "~6.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testEnvironment": "@shopify/react-native-skia/jestEnv.js",
        "transform": {
          "[/\\\\]NightMap\\.tsx$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ],
              "caller": {
                "name": "metro",
                "bundler": "metro",
                "platform": "web",
                "isDomComponent": true
              }
            }
          ]
        },
        "testEnvironmentOptions": {
          "customExportConditions": [
            "require",
            "react-native"
          ]
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@shopify/react-native-skia))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ],
        "moduleNameMapper": {
          "^@/assets/(.*)$": "<rootDir>/assets/$1",
          "^@/(.*)$": "<rootDir>/src/$1"
        },
        "resolver": "react-native-reanimated/jest/resolver",
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/src/features/map/__tests__/NightMap\\.test\\.tsx",
          "/src/features/map/__tests__/pointMarkers\\.images\\.test\\.ts",
          "/src/features/point/__tests__/PointLocationMap\\.test\\.tsx"
        ]
      },
      {
        "displayName": "dom",
        "preset": "jest-expo/web",
        "testMatch": [
          "<rootDir>/src/features/map/__tests__/NightMap.test.tsx",
          "<rootDir>/src/features/map/__tests__/pointMarkers.images.test.ts",
          "<rootDir>/src/features/point/__tests__/PointLocationMap.test.tsx"
        ],
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@shopify/react-native-skia))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ],
        "moduleNameMapper": {
          "^@/assets/(.*)$": "<rootDir>/assets/$1",
          "^@/(.*)$": "<rootDir>/src/$1"
        },
        "setupFilesAfterEnv": [
          "<rootDir>/jest.dom.setup.ts"
        ]
      }
    ]
  }
}
