# Nginx és l'únic punt d'entrada (ADR-0006, ADR-0019). La imatge oficial substitueix
# ${PUBLIC_HOST} i ${PUBLIC_PORT} a l'arrencada; les variables pròpies de Nginx ($host…) no es toquen.
#
# La VM de la FIB només té ports 8080–8089 (nattech.fib.upc.edu:40000+XXX·10 … +9).
# Per això HTTPS escolta al 8080 i no hi ha port 80: el certificat s'emet amb DNS-01.

# Límit de peticions per IP: l'API és pública i cada consulta va a la BD, que té 5 connexions.
# Generós a propòsit: si el NAT de la FIB no conservés la IP del client, seria un límit per a tothom.
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;

# Registre d'accés sense la query string: GET /recomanacions hi porta la ubicació de qui consulta
# (lat i lon), i la política de privacitat (web/privacitat.html) diu que no queda al registre.
log_format sense_query '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                       '$status $body_bytes_sent $request_time "$http_user_agent"';

# CSP de la web d'administració (TG-176): només scripts propis, i connexions a l'API (mateix origen)
# i a Supabase Auth. El login amb Google és una navegació de pàgina sencera, que la CSP no limita.
map $host $csp_admin {
    default "default-src 'self'; connect-src 'self' ${SUPABASE_URL}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'";
}

server {
    listen 8080 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Una petició en HTTP pla al port TLS: redirigeix a HTTPS amb el port públic.
    # El host és el nostre, no el de la petició: una capçalera Host falsa no redirigeix enlloc més.
    error_page 497 =301 https://${PUBLIC_HOST}:${PUBLIC_PORT}$request_uri;

    server_tokens off;
    access_log /var/log/nginx/access.log sense_query;
    include /etc/nginx/snippets/seguretat.conf;
    # Redireccions relatives (/admin → /admin/): Nginx hi posaria el port intern (8080), no el públic.
    absolute_redirect off;

    client_max_body_size 1m;

    gzip on;
    # text/html sempre es comprimeix (posar-lo aquí dona un avís de tipus duplicat).
    gzip_types application/json text/css application/javascript image/svg+xml;

    location /api/v1/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    # Web d'administració (TG-176, ADR-0030), compilada a la imatge (deploy/nginx/Dockerfile).
    # Amb root (no alias), $uri és el camí del fitxer tal qual i try_files no té sorpreses.
    location = /admin {
        return 301 /admin/;
    }

    location /admin/ {
        root /usr/share/nginx;
        # Qualsevol ruta interna de l'app (una recàrrega directa) serveix l'index.html.
        try_files $uri $uri/ /admin/index.html;
        # index.html i la resta sense hash: es revaliden, i un deploy nou es veu en recarregar.
        include /etc/nginx/snippets/seguretat.conf;
        add_header Content-Security-Policy $csp_admin always;
        add_header Cache-Control "no-cache" always;

        # Recursos amb hash al nom: cache llarga. Un que no existeix és un 404, no l'index.html.
        location /admin/assets/ {
            try_files $uri =404;
            include /etc/nginx/snippets/seguretat.conf;
            add_header Content-Security-Policy $csp_admin always;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }
    }

    # La resta (també /): 404 en JSON, com l'API.
    location / {
        default_type application/json;
        return 404 '{"error":{"code":"not_found","message":"Ruta no trobada"}}';
    }
}
