# Nginx és l'únic punt d'entrada (ADR-0006, ADR-0019). La imatge oficial substitueix
# ${PUBLIC_HOST} i ${PUBLIC_PORT} a l'arrencada; les variables pròpies de Nginx ($host…) no es toquen.
#
# La VM de la FIB només té ports 8080–8089 (nattech.fib.upc.edu:40000+XXX·10 … +9).
# Per això HTTPS escolta al 8080 i no hi ha port 80: el certificat s'emet amb DNS-01.

# Límit de peticions per IP: l'API és pública i cada consulta va a la BD, que té 5 connexions.
# Generós a propòsit: si el NAT de la FIB no conservés la IP del client, seria un límit per a tothom.
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;

server {
    listen 8080 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Una petició en HTTP pla al port TLS: redirigeix a HTTPS amb el port públic.
    # El host és el nostre, no el de la petició: una capçalera Host falsa no redirigeix enlloc més.
    error_page 497 =301 https://${PUBLIC_HOST}:${PUBLIC_PORT}$request_uri;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    client_max_body_size 1m;

    gzip on;
    gzip_types application/json text/css application/javascript;

    location /api/v1/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    # La web d'administració (P11, Sprint 2) es servirà aquí.
    location / {
        default_type application/json;
        return 404 '{"error":{"code":"not_found","message":"Ruta no trobada"}}';
    }
}
