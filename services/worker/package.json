{
  "name": "@talaia/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker de Talaia: ingesta de dades externes i recàlcul horari de l'índex de visibilitat.",
  "scripts": {
    "meteo": "tsx --env-file-if-exists=../../.env src/meteo/cli.ts",
    "astronomia:calendari": "tsx src/astronomia/calendari-cli.ts",
    "astro": "tsx src/astronomia/cli.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint .",
    "index": "tsx --env-file-if-exists=../../.env src/index/cli.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@talaia/db": "*",
    "@talaia/shared": "*",
    "astronomy-engine": "^2.1.19",
    "kysely": "^0.28.17",
    "node-cron": "^4.6.0",
    "zod": "^4.6.5"
  }
}
