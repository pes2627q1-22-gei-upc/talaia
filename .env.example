# Copia aquest fitxer a .env (a l'arrel) i omple els valors. Mai pugis el .env al repositori.
# El llegeixen l'API, el worker i el CLI de Supabase. Les variables de l'app van a apps/mobile/.env.example.
# D'on surt cada valor: docs/onboarding.md, secció 5.

# Supabase
SUPABASE_URL=
# Google Auth (Supabase local): es llegeixen des del .env de l'arrel per a `supabase/config.toml`.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
# Session pooler (usuari postgres.<ref>): el host directe db.<ref>.supabase.co només té IPv6.
# Acaba-la amb ?sslmode=no-verify: xifra la connexió sense validar el certificat de Supabase, que no és
# a la cadena de confiança de Node. Amb sslmode=require, pg falla; sense sslmode, va sense xifrar.
# Opcional per a l'API: sense ella arrenca amb un avís, /health funciona i /punts respon 503.
# En local amb Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Connexió Postgres per a l'API, el worker i db:types:verify.
DATABASE_URL=

# API
API_PORT=3000                    # services/api; es valida a l'arrencada (src/config/env.ts)
API_PUBLIC_URL=                  # https://<PUBLIC_HOST>:<PUBLIC_PORT>/api/v1

# Desplegament a la VM (deploy/compose.yaml, docs/desplegament.md). A la VM, aquest fitxer és /opt/talaia/.env.
# Docker Compose llegeix un comentari al final d'una línia buida com si fos el valor:
# a les variables que fa servir el compose, el comentari va a la línia de sobre.
# Nom de DuckDNS que apunta a nattech.fib.upc.edu.
PUBLIC_HOST=talaia.duckdns.org
# Port públic de nattech: 40000 + XXX·10 (a local, 8080).
PUBLIC_PORT=8080
# Correu per als avisos de Let's Encrypt.
ACME_EMAIL=
# Token del compte de DuckDNS, per al repte DNS-01.
DUCKDNS_TOKEN=
# Clau que fa servir Aprop per consumir el servei d'esdeveniments (mínim 32 caràcters).
APROP_API_KEY=

# Serveis externs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Clau de l'API de Meteocat (pla gratuït «Accés ciutadà», amb «Dades de la XEMA»). Opcional:
# sense ella el worker no ingesta les observacions (TG-115). Secreta: només el worker.
METEOCAT_API_KEY=
MOBILICAT_ROUTES_BASE_URL=
MOBILICAT_ROUTES_API_KEY=
